8.2 CSV Rows with Mixed Types — Input: "apple", 10.0, 5 (one item per line)

#include <iostream>
#include <vector>
#include <string>
#include <sstream>
#include <tuple>
using namespace std;
int main() {
vector<tuple<string,double,int>> list;
string line;
while (getline(cin, line)) {
if (line.empty()) break;
string clean = "";
for (char ch : line) if (ch != '"') clean += ch;
stringstream ss(clean);
string item, ps, qs;
getline(ss, item, ',');
getline(ss, ps, ',');
getline(ss, qs, ',');
// trim whitespace from each field
auto trim = [](string s) {
size_t a = s.find_first_not_of(' ');
size_t b = s.find_last_not_of(' ');
return (a == string::npos) ? "" : s.substr(a, b-a+1);
};
list.emplace_back(trim(item), stod(trim(ps)), stoi(trim(qs)));
}
for (auto &[item, price, qty] : list)
cout << item << ", " << price << ", " << qty << "\n";
return 0;
}

