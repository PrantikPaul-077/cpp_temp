7. 2D Arrays / Matrices
7.1 Row × Column Input — Line 1: rows cols then each row on its own line
💡 First line provides dimensions; each subsequent line is one row of values.

#include <iostream>
#include <vector>
using namespace std;
int main() {
int r, c;
cin >> r >> c;
vector<vector<int>> matrix(r, vector<int>(c));
for (int i = 0; i < r; i++)
for (int j = 0; j < c; j++)
cin >> matrix[i][j];
for (auto &row : matrix) {
for (int x : row) cout << x << " ";
cout << "\n";
}
return 0;
}

