6.3 Quoted Strings — Input: ["AB","BC","CD"]

#include <iostream>
#include <vector>
#include <string>
#include <sstream>
using namespace std;
int main() {
string input;
getline(cin, input);
string clean = "";
for (char ch : input)
if (ch != '[' && ch != ']' && ch != '"') clean += ch;
vector<string> arr;
stringstream ss(clean);
string token;
while (getline(ss, token, ',')) {
// trim spaces
size_t start = token.find_first_not_of(' ');

size_t end = token.find_last_not_of(' ');
if (start != string::npos)
arr.push_back(token.substr(start, end - start + 1));
}
for (const string &s : arr) cout << s << " ";
return 0;
}

